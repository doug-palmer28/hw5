# Copy this file to .env (in the repo root) and fill in your key. .env is gitignored.
# The agents call OpenAI's gpt-6-luna through the Portkey gateway.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: override the gateway URL (default https://api.portkey.ai/v1)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
